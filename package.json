{
	"name": "exact-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.6.4",
	"workspaces": [
		"agents/*",
		"packages/*",
		"framework-adapters/*",
		"react-adapters/*",
		"plugins/*",
		"component-libraries/*",
		"apps/*",
		"native/npm/*"
	],
	"scripts": {
		"generate:app-artifacts": "npm run generate -w @exactjs/sample-server-components && npm run generate -w @exactjs/sample-shipping-calculator",
		"build": "npm run build:prerequisites && npm run build:native-compiler && npm run build:workspaces",
		"build:prerequisites": "npm run build -w @exactjs/core",
		"build:workspaces": "npm run generate:app-artifacts && tsc6 -b",
		"build:typescript7": "npm run generate:app-artifacts && tsc -b",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --cache --cache-location .tmp/eslint-cache",
		"lint:fix": "npm run lint -- --fix",
		"check:style": "npm run format:check && npm run lint",
		"test": "npm run test:build-scripts && npm run test:packages && npm run test:server-components && npm run test:shipping",
		"test:build-scripts": "node --test scripts/local-build.test.mjs scripts/native-compiler-source.test.mjs scripts/native-compiler-build-cache.test.mjs",
		"test:bun": "npm run build -w @exactjs/bun-plugin -w @exactjs/bun-adapter -w @exactjs/bun-test && npm run test:bun -w @exactjs/bun-plugin -w @exactjs/bun-adapter -w @exactjs/bun-test",
		"check:publish": "node scripts/check-release-manifests.mjs && node scripts/check-native-compiler-packages.mjs && node scripts/check-compiler-distribution.mjs && node scripts/check-package-agent-guides.mjs && node scripts/check-package-contents.mjs && npm run check:readmes",
		"check:readmes": "node scripts/check-package-readmes.mjs",
		"version:packages": "node scripts/version-packages.mjs",
		"release:check": "node scripts/release-check.mjs --profile=check",
		"release:quick": "node scripts/release-check.mjs --profile=quick",
		"release:affected": "node scripts/release-check.mjs --profile=affected",
		"release:full": "node scripts/release-check.mjs --profile=full",
		"performance:check": "node scripts/release-check.mjs --profile=performance",
		"check:platform-boundaries": "node scripts/check-platform-boundaries.mjs",
		"check:source-architecture": "node scripts/check-source-architecture.mjs",
		"check:jsdoc": "node scripts/check-jsdoc.mjs",
		"check:sample-builds": "npm run build:kanban && npm run build:workbench && npm run build:sudoku && npm run build:microfrontends",
		"test:packages": "vitest run --config vitest.config.ts packages framework-adapters react-adapters plugins component-libraries --testTimeout=30000",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"typecheck": "npm run generate:app-artifacts && tsc6 -b --pretty",
		"typecheck:typescript7": "npm run generate:app-artifacts && tsc -b --pretty",
		"typecheck:tests": "tsc6 -p tsconfig.test.json --pretty",
		"check:typescript-compatibility": "node scripts/check-typescript-compatibility.mjs",
		"benchmark:reactive": "node scripts/benchmark-reactive.mjs && node scripts/benchmark-dom-list.mjs",
		"benchmark:expressions": "node scripts/benchmark-expressions.mjs && node scripts/benchmark-compiler-workflow.mjs && node scripts/benchmark-language-service.mjs",
		"benchmark:devtools": "node scripts/benchmark-devtools.mjs",
		"poc:native-checker": "npm run build -w @exactjs/expressions && node experiments/typescript7-native-checker/probe.mjs",
		"check:expressions": "node scripts/check-expressions-roundtrip.mjs",
		"check:native-compiler-corpus": "node scripts/check-native-compiler-corpus.mjs",
		"check:compiler-acceptance": "npm run build && npm run check:compiler-acceptance:built",
		"check:compiler-acceptance:built": "node --test scripts/release-affected.test.mjs && node scripts/check-compiler-acceptance.mjs",
		"build:native-compiler": "node scripts/build-native-compiler.mjs",
		"package:native-compiler": "node scripts/package-native-compiler.mjs",
		"check:expressions:baseline": "node scripts/check-expressions-roundtrip.mjs --update-baseline",
		"check:react-compat": "npm run build -w @exactjs/react-compatibility && npm run check:react-compat:built",
		"check:react-compat:built": "node scripts/check-react-package-corpus.mjs && node scripts/check-react-conformance.mjs && node scripts/check-react-reconciler-compat.mjs",
		"check:react-reconciler": "npm run build && node scripts/check-react-reconciler-compat.mjs",
		"check:r3f-browser": "npm run build && npm run check:r3f-browser:built",
		"check:r3f-browser:built": "node scripts/check-r3f-browser.mjs",
		"check:react-auto-bundle": "npm run build && node scripts/check-react-auto-bundle.mjs",
		"check:router-bundles": "node scripts/check-router-bundles.mjs",
		"benchmark:react-compat": "node scripts/benchmark-react-compat.mjs",
		"benchmark:react-adapters": "npm run build -w @exactjs/react-compat && node scripts/benchmark-react-compat-adapters.mjs",
		"dev:kanban": "npm run dev -w @exactjs/sample-kanban",
		"build:kanban": "npm run build -w @exactjs/sample-kanban",
		"dev:workbench": "npm run dev -w @exactjs/sample-workbench",
		"build:workbench": "npm run build -w @exactjs/sample-workbench",
		"dev:sudoku": "npm run dev -w @exactjs/sample-sudoku",
		"build:sudoku": "npm run build -w @exactjs/sample-sudoku",
		"build:sudoku:standalone": "npm run build:standalone -w @exactjs/sample-sudoku",
		"test:sudoku": "npm run test -w @exactjs/sample-sudoku",
		"dev:microfrontends": "npm run dev -w @exactjs/sample-microfrontend-portal",
		"build:microfrontends": "npm run build -w @exactjs/sample-microfrontend-portal",
		"start:microfrontends": "npm run start -w @exactjs/sample-microfrontend-portal",
		"test:microfrontends": "npm run test -w @exactjs/sample-microfrontend-portal",
		"build:server-components": "npm run build -w @exactjs/sample-server-components",
		"test:server-components": "npm run test -w @exactjs/sample-server-components",
		"dev:shipping": "npm run dev -w @exactjs/sample-shipping-calculator",
		"build:shipping": "npm run build -w @exactjs/sample-shipping-calculator",
		"test:shipping": "npm run test -w @exactjs/sample-shipping-calculator",
		"test:e2e:shipping": "npm run test:e2e -w @exactjs/sample-shipping-calculator",
		"start:shipping": "npm run start -w @exactjs/sample-shipping-calculator"
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"@types/node": "^22.10.2",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "0.27.2",
		"eslint": "9.39.1",
		"globals": "16.5.0",
		"jsdom": "^25.0.1",
		"prettier": "3.6.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-router-dom-v5": "npm:react-router-dom@5.3.4",
		"react-router-dom-v6": "npm:react-router-dom@6.30.4",
		"react-router-dom-v63": "npm:react-router-dom@6.3.0",
		"react-router-dom-v7": "npm:react-router-dom@7.18.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "8.65.0",
		"vitest": "^4.1.10"
	}
}
