{
	"name": "@exactjs/config",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/node.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/language-extension-api": "^0.1.0",
		"@exactjs/devtools-protocol": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
