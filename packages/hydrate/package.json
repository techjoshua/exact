{
	"name": "@exactjs/hydrate",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"default": "./dist/internal.js"
		},
		"./enhanced": {
			"types": "./dist/enhanced.d.ts",
			"default": "./dist/enhanced.js"
		},
		"./root": {
			"types": "./dist/root.d.ts",
			"default": "./dist/root.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/server": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/accessibility": "^0.1.0",
		"@exactjs/testing": "^0.1.0",
		"@exactjs/time": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
