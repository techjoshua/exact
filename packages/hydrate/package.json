{
	"name": "@exact/hydrate",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"default": "./dist/internal.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exact/core": "file:../core",
		"@exact/dom": "file:../dom",
		"@exact/instrumentation": "file:../instrumentation",
		"@exact/server": "file:../server"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	}
}
