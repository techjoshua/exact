{
	"name": "@exactjs/hydrate",
	"version": "0.6.4",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"default": "./dist/internal.js"
		},
		"./enhanced": {
			"types": "./dist/enhanced.d.ts",
			"default": "./dist/enhanced.js"
		},
		"./root": {
			"types": "./dist/root.d.ts",
			"default": "./dist/root.js"
		},
		"./framework/component-root": {
			"types": "./dist/framework/component-root.d.ts",
			"default": "./dist/framework/component-root.js"
		},
		"./framework/client-bootstrap": {
			"types": "./dist/framework/client-bootstrap.d.ts",
			"default": "./dist/framework/client-bootstrap.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/core": "^0.6.3",
		"@exactjs/dom": "^0.6.0",
		"@exactjs/instrumentation": "^0.5.0 || ^0.6.0"
	},
	"devDependencies": {
		"@exactjs/accessibility": "^0.6.0",
		"@exactjs/server": "^0.6.0",
		"@exactjs/testing": "^0.6.0",
		"@exactjs/time": "^0.6.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/hydrate"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/server-execution",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Browser hydration and server-response patching for eXact applications.",
	"keywords": [
		"exactjs",
		"hydration",
		"ssr",
		"client-islands"
	]
}
