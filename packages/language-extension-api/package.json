{
	"name": "@exactjs/language-extension-api",
	"version": "0.6.1",
	"description": "Stable contracts for eXact language-service contributions",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"AGENTS.md",
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/language-extension-api"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/language-tools",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"language-service",
		"diagnostics",
		"typescript"
	]
}
