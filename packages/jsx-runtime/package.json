{
	"name": "@exactjs/jsx",
	"version": "0.6.1",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.6.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run --config ../../vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/jsx-runtime"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/compiler-tour",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Compiler-only automatic JSX surface and TypeScript JSX declarations for eXact.",
	"keywords": [
		"exactjs",
		"jsx",
		"tsx",
		"typescript"
	]
}
