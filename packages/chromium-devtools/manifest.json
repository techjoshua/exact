{
	"manifest_version": 3,
	"name": "eXact DevTools",
	"version": "0.1.0",
	"description": "Full-stack component inspection for eXact applications.",
	"devtools_page": "dist/devtools.html",
	"background": {
		"service_worker": "dist/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["dist/content-script.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["dist/page-bridge.js"],
			"matches": ["<all_urls>"]
		}
	],
	"permissions": []
}
