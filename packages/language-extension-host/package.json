{
	"name": "@exactjs/language-extension-host",
	"version": "0.1.0",
	"description": "Development-time host for trusted eXact language contributions",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runner": "./dist/runner.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/config": "^0.1.0",
		"@exactjs/language-extension-api": "^0.1.0",
		"@exactjs/package-provenance": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
