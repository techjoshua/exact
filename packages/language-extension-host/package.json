{
	"name": "@exactjs/language-extension-host",
	"version": "0.5.0",
	"description": "Development-time host for trusted eXact language contributions",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runner": "./dist/runner.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/config": "^0.5.0",
		"@exactjs/language-extension-api": "^0.5.0",
		"@exactjs/package-provenance": "^0.5.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/language-extension-host"
	},
	"homepage": "https://github.com/techjoshua/exact#readme",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	}
}
