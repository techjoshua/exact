{
	"name": "@exactjs/intl",
	"version": "0.5.1",
	"description": "Enhancement-first internationalization contracts and runtime for eXact",
	"type": "module",
	"files": [
		"AGENTS.md",
		"README.md",
		"LICENSE.cldr",
		"capability.d.ts",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./enhancements": {
			"types": "./capability.d.ts",
			"browser": "./dist/client/enhancements.js",
			"default": "./dist/server/enhancements.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"browser": "./dist/client/internal.js",
			"default": "./dist/server/internal.js"
		},
		"./language": {
			"types": "./dist/language.d.ts",
			"node": "./dist/server/language.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": {
		".": [
			"IntlProvider",
			"IntlLocale",
			"IntlMessage",
			"IntlPlural",
			"IntlSelect",
			"IntlCurrency",
			"IntlUnit",
			"IntlAttributes"
		],
		"./enhancements": [
			"alt",
			"ariaDescription",
			"ariaLabel",
			"ariaRoledescription",
			"ariaValuetext",
			"cldr",
			"currency",
			"default",
			"locale",
			"message",
			"placeholder",
			"plural",
			"select",
			"title",
			"unit"
		]
	},
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"exact": {
		"language": {
			"schemaVersion": 1,
			"analyzer": {
				"protocolVersion": "^1.0.0",
				"subpath": "./language",
				"capabilities": [
					"diagnostics",
					"completions",
					"hover",
					"inlayHints"
				],
				"projection": [
					"sourceText",
					"imports",
					"enhancements",
					"jsx"
				]
			}
		}
	},
	"dependencies": {
		"@exactjs/component-library": "^0.5.0",
		"@exactjs/core": "^0.5.0",
		"@exactjs/dom": "^0.5.0",
		"@exactjs/language-extension-api": "^0.5.0",
		"@exactjs/reactive": "^0.5.0",
		"@exactjs/ssr": "^0.5.0"
	},
	"peerDependencies": {
		"@exactjs/intl-analyzer": "^0.5.0"
	},
	"peerDependenciesMeta": {
		"@exactjs/intl-analyzer": {
			"optional": true
		}
	},
	"devDependencies": {
		"cldr-core": "48.2.0",
		"prettier": "^3.6.2"
	},
	"scripts": {
		"generate:cldr": "node scripts/generate-cldr-unit-data.mjs",
		"check:cldr": "node scripts/generate-cldr-unit-data.mjs --check",
		"build": "npm run check:cldr && tsc -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "npm run check:cldr && vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/intl"
	},
	"homepage": "https://techjoshua.github.io/exact/#/plugins/internationalization",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"i18n",
		"internationalization",
		"localization"
	]
}
