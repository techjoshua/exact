{
	"name": "@exactjs/testing",
	"version": "0.6.1",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client-artifact/index.js",
			"default": "./dist/server-artifact/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"browser": "./dist/client-artifact/plugins.js",
			"default": "./dist/server-artifact/plugins.js"
		},
		"./vitest": {
			"types": "./dist/vitest.d.ts",
			"browser": "./dist/client-artifact/vitest.js",
			"default": "./dist/server-artifact/vitest.js"
		},
		"./jest": {
			"types": "./dist/jest.d.ts",
			"browser": "./dist/client-artifact/jest.js",
			"default": "./dist/server-artifact/jest.js"
		},
		"./internal/fixtures": {
			"types": "./dist/internal/fixtures.d.ts",
			"browser": "./dist/client-artifact/internal/fixtures.js",
			"default": "./dist/server-artifact/internal/fixtures.js"
		}
	},
	"main": "./dist/server-artifact/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [],
	"exactCompileModules": [
		"src/mounting/mount.ts"
	],
	"exactTargetDirectories": {
		"client": "client-artifact",
		"server": "server-artifact"
	},
	"dependencies": {
		"@exactjs/core": "^0.6.0",
		"@exactjs/dom": "^0.6.0",
		"@exactjs/hydrate": "^0.6.0",
		"@exactjs/jsx": "^0.6.0",
		"@exactjs/plugin-host": "^0.5.0 || ^0.6.0",
		"@exactjs/reactive": "^0.6.0",
		"@exactjs/server": "^0.6.0",
		"@exactjs/ssr": "^0.6.0"
	},
	"devDependencies": {
		"vitest": "^4.1.11"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "vitest run --config vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/testing"
	},
	"homepage": "https://techjoshua.github.io/exact/#/guides/testing",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Runner-neutral tools for testing eXact components and server behavior.",
	"keywords": [
		"exactjs",
		"testing",
		"components",
		"ssr"
	]
}
