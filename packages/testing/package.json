{
	"name": "@exactjs/testing",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"default": "./dist/plugins.js"
		},
		"./vitest": {
			"types": "./dist/vitest.d.ts",
			"default": "./dist/vitest.js"
		},
		"./jest": {
			"types": "./dist/jest.d.ts",
			"default": "./dist/jest.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/plugin-host": "^0.1.0",
		"@exactjs/reactive": "^0.1.0"
	},
	"devDependencies": {
		"vitest": "^2.1.8"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
