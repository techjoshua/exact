{
	"name": "@exactjs/reactive",
	"version": "0.6.1",
	"type": "module",
	"sideEffects": false,
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./framework/watch": {
			"types": "./dist/framework/watch.d.ts",
			"default": "./dist/framework/watch.js"
		},
		"./framework/objects": {
			"types": "./dist/framework/objects.d.ts",
			"default": "./dist/framework/objects.js"
		},
		"./framework/indexed-objects": {
			"types": "./dist/framework/indexed-objects.d.ts",
			"default": "./dist/framework/indexed-objects.js"
		},
		"./framework/indexed-collections": {
			"types": "./dist/framework/indexed-collections.d.ts",
			"default": "./dist/framework/indexed-collections.js"
		},
		"./framework/runtime": {
			"types": "./dist/framework/runtime.d.ts",
			"default": "./dist/framework/runtime.js"
		},
		"./framework/values": {
			"types": "./dist/framework/values.d.ts",
			"default": "./dist/framework/values.js"
		},
		"./framework/tracking": {
			"types": "./dist/framework/tracking.d.ts",
			"default": "./dist/framework/tracking.js"
		},
		"./framework/protocol": {
			"types": "./dist/framework/protocol.d.ts",
			"default": "./dist/framework/protocol.js"
		},
		"./framework/settlement": {
			"types": "./dist/framework/settlement.d.ts",
			"default": "./dist/framework/settlement.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/instrumentation": "^0.5.0 || ^0.6.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/reactive"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/state",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Fine-grained reactive primitives and observable collections used by eXact.",
	"keywords": [
		"exactjs",
		"reactivity",
		"observable",
		"state-management"
	]
}
