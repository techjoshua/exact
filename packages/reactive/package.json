{
	"name": "@exactjs/reactive",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./framework/watch": {
			"types": "./dist/framework/watch.d.ts",
			"default": "./dist/framework/watch.js"
		},
		"./framework/objects": {
			"types": "./dist/framework/objects.d.ts",
			"default": "./dist/framework/objects.js"
		},
		"./framework/indexed-objects": {
			"types": "./dist/framework/indexed-objects.d.ts",
			"default": "./dist/framework/indexed-objects.js"
		},
		"./framework/runtime": {
			"types": "./dist/framework/runtime.d.ts",
			"default": "./dist/framework/runtime.js"
		},
		"./framework/settlement": {
			"types": "./dist/framework/settlement.d.ts",
			"default": "./dist/framework/settlement.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/instrumentation": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
