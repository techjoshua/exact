{
	"name": "@exactjs/intl-analyzer",
	"version": "0.6.0",
	"description": "Build-only source analyzer for eXact internationalization",
	"type": "module",
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./xliff": {
			"types": "./dist/xliff-xml.d.ts",
			"default": "./dist/xliff-xml.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/compiler": "^0.6.0",
		"@exactjs/core": "^0.6.0",
		"@exactjs/intl": "^0.6.0",
		"saxes": "^6.0.0"
	},
	"devDependencies": {
		"@exactjs/core": "^0.6.0",
		"@exactjs/dom": "^0.6.0",
		"@exactjs/hydrate": "^0.6.0",
		"@exactjs/reactive": "^0.6.0",
		"@exactjs/ssr": "^0.6.0",
		"@exactjs/testing": "^0.6.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/intl-analyzer"
	},
	"homepage": "https://techjoshua.github.io/exact/#/plugins/internationalization",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"i18n",
		"internationalization",
		"compiler"
	]
}
