{
	"name": "@exactjs/bun-test",
	"version": "0.7.1",
	"description": "Bun test runner integration, DOM setup, compiler preload, and matchers for eXact",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./setup": {
			"types": "./dist/setup.d.ts",
			"default": "./dist/setup.js"
		},
		"./preload": {
			"types": "./dist/preload.d.ts",
			"default": "./dist/preload.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/bun-plugin": "^0.7.1",
		"@exactjs/testing": "^0.7.1",
		"@happy-dom/global-registrator": "^20.11.1"
	},
	"peerDependencies": {
		"@types/bun": ">=1.3.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "npm run typecheck:test && bun --conditions=browser test --preload ./test-fixtures/compiler-preload.ts ./test-fixtures/component.bun.test.tsx ./test-fixtures/inline-components.bun.test.tsx",
		"test:bun": "npm run typecheck:test && bun --conditions=browser test --preload ./test-fixtures/compiler-preload.ts ./test-fixtures/component.bun.test.tsx ./test-fixtures/inline-components.bun.test.tsx",
		"typecheck:test": "tsc6 -p tsconfig.test.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/bun-test"
	},
	"homepage": "https://techjoshua.github.io/exact/#/guides/testing",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"bun",
		"testing",
		"matchers"
	]
}
