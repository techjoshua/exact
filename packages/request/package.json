{
	"name": "@exactjs/request",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/server/node.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exactCompiledComponents": [
		"RequestProvider"
	],
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/ssr": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
