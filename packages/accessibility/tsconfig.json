{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "@exactjs/jsx"
	},
	"references": [
		{ "path": "../core" },
		{ "path": "../jsx-runtime" },
		{ "path": "../reactive" },
		{ "path": "../language-extension-api" }
	],
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
