{
	"name": "@exactjs/component-library-policy",
	"version": "0.6.1",
	"description": "Shared build-time authorization policy for eXact component libraries",
	"type": "module",
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE",
		"!dist/test-support/**"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"node": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/compiler": "^0.6.0",
		"@exactjs/config": "^0.5.0 || ^0.6.0",
		"semver": "^7.8.5"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/component-library-policy"
	},
	"homepage": "https://techjoshua.github.io/exact/#/components/trust",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"component-library",
		"build-tools",
		"authorization"
	]
}
