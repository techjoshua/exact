{
	"name": "@exactjs/react-compat-build",
	"version": "0.6.1",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		}
	},
	"bin": {
		"exact-reactc": "./dist/cli.js",
		"exact-react-compat": "./dist/tool.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/compiler": "^0.6.0",
		"@exactjs/react-compat": "^0.6.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/react-compat-build"
	},
	"homepage": "https://techjoshua.github.io/exact/#/guides/react-compatibility",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Command-line and Node build tools for eXact React compatibility.",
	"keywords": [
		"exactjs",
		"react",
		"compatibility",
		"compiler"
	]
}
