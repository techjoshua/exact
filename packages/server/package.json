{
	"name": "@exactjs/server",
	"version": "0.6.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"node": "./dist/plugins.js",
			"default": "./dist/plugins.js"
		},
		"./framework/trusted-handler": {
			"types": "./dist/framework/trusted-handler.d.ts",
			"default": "./dist/framework/trusted-handler.js"
		},
		"./framework/response-encoding": {
			"types": "./dist/framework/response-encoding.d.ts",
			"default": "./dist/framework/response-encoding.js"
		},
		"./framework/render-scheduling": {
			"types": "./dist/framework/render-scheduling.d.ts",
			"default": "./dist/framework/render-scheduling.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.6.0",
		"@exactjs/devtools-protocol": "^0.5.0",
		"@exactjs/instrumentation": "^0.5.0",
		"@exactjs/request": "^0.6.0",
		"@exactjs/plugin-api": "^0.5.0",
		"@exactjs/plugin-host": "^0.5.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/server"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/server-execution",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Transport-neutral server runtime for eXact operations, refreshes, patches, and server components.",
	"keywords": [
		"exactjs",
		"server",
		"server-components",
		"rpc"
	]
}
