{
	"name": "@exact/server",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"node": "./dist/plugins.js",
			"default": "./dist/plugins.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exact/core": "file:../core",
		"@exact/instrumentation": "file:../instrumentation",
		"@exact/request": "file:../request",
		"@exact/plugin-api": "file:../plugin-api",
		"@exact/plugin-host": "file:../plugin-host"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	}
}
