{
	"name": "@exactjs/jest",
	"version": "0.1.0",
	"description": "Jest matchers and component-testing integration for eXact applications",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./setup": {
			"types": "./dist/setup.d.ts",
			"default": "./dist/setup.js"
		},
		"./transformer": {
			"types": "./dist/transformer.d.ts",
			"default": "./dist/transformer.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/compiler": "^0.1.0",
		"@exactjs/testing": "^0.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"peerDependencies": {
		"@jest/globals": "^29.0.0 || ^30.0.0",
		"jest": "^29.0.0 || ^30.0.0",
		"jest-environment-jsdom": "^29.0.0 || ^30.0.0"
	},
	"devDependencies": {
		"@jest/globals": "^30.2.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:jest": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config test-fixtures/jest.config.mjs",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
