{
	"name": "@exactjs/theme",
	"version": "0.1.0",
	"description": "Deterministic semantic theme generation and enhancements for eXact",
	"type": "module",
	"files": [
		"AGENTS.md",
		"README.md",
		"capability.d.ts",
		"dist",
		"styles.css",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./enhancements": {
			"types": "./capability.d.ts",
			"default": "./dist/enhancements.js"
		},
		"./styles.css": "./styles.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./styles.css"
	],
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"color-name": "^2.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0",
		"@exactjs/hydrate": "^0.1.0",
		"@exactjs/ssr": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node scripts/generate-styles.mjs && prettier --write styles.css && node ../../scripts/generate-component-library-build-facts.mjs .",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
