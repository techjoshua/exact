{
	"name": "@exactjs/theme",
	"version": "0.1.0",
	"description": "Deterministic semantic theme generation and enhancements for eXact",
	"type": "module",
	"files": [
		"AGENTS.md",
		"README.md",
		"capability.d.ts",
		"dist",
		"styles.css",
		"!dist/**/*.test.*",
		"!dist/**/*.fixtures.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./enhancements": {
			"types": "./capability.d.ts",
			"browser": "./dist/client/enhancements.js",
			"default": "./dist/server/enhancements.js"
		},
		"./styles.css": "./styles.css"
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": {
		"./enhancements": [
			"scope",
			"surface",
			"action",
			"field",
			"text",
			"status",
			"separator",
			"selection"
		]
	},
	"sideEffects": [
		"./styles.css"
	],
	"exactComponentLibrary": {
		"protocol": 2,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"@exactjs/ssr": "^0.1.0",
		"color-name": "^2.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0",
		"@exactjs/hydrate": "^0.1.0",
		"@exactjs/ssr": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs . && node scripts/generate-styles.mjs && prettier --write styles.css",
		"check:performance": "npm run build && node scripts/check-performance.mjs",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
