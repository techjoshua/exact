{
	"name": "@exactjs/compiler",
	"version": "0.6.2",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist/adapter-support.*",
		"dist/artifact-isolation.*",
		"dist/artifacts.*",
		"dist/cli.*",
		"dist/component-library-build.*",
		"dist/compilation",
		"dist/contracts",
		"dist/explanation.*",
		"dist/exposures.*",
		"dist/expression/project.*",
		"dist/expression/session.*",
		"dist/expression/session-contracts.*",
		"dist/expression/watch-invalidation.*",
		"dist/ids.*",
		"dist/index.*",
		"dist/language-tools",
		"dist/names.*",
		"dist/native",
		"dist/paths.*",
		"dist/policy-report.*",
		"dist/registry.*",
		"dist/source-maps.*",
		"dist/types.*",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./adapter-support": {
			"types": "./dist/adapter-support.d.ts",
			"default": "./dist/adapter-support.js"
		},
		"./component-library-build": {
			"types": "./dist/component-library-build.d.ts",
			"default": "./dist/component-library-build.js"
		}
	},
	"bin": {
		"exactc": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/config": "^0.5.0 || ^0.6.0",
		"@exactjs/devtools-protocol": "^0.5.0 || ^0.6.0",
		"@exactjs/instrumentation": "^0.5.0 || ^0.6.0",
		"@exactjs/language-extension-api": "^0.5.0 || ^0.6.0",
		"@exactjs/language-extension-host": "^0.5.0 || ^0.6.0",
		"@jridgewell/remapping": "^2.3.5"
	},
	"optionalDependencies": {
		"@exactjs/compiler-native-darwin-arm64": "0.6.2",
		"@exactjs/compiler-native-darwin-x64": "0.6.2",
		"@exactjs/compiler-native-linux-arm64": "0.6.2",
		"@exactjs/compiler-native-linux-x64": "0.6.2",
		"@exactjs/compiler-native-win32-arm64": "0.6.2",
		"@exactjs/compiler-native-win32-x64": "0.6.2"
	},
	"devDependencies": {
		"@exactjs/core": "^0.6.0",
		"@exactjs/testing": "^0.6.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.1.5"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run --maxWorkers=4",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/compiler"
	},
	"homepage": "https://techjoshua.github.io/exact/#/learn/compiler-tour",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "The native TypeScript and TSX compiler for eXact applications.",
	"keywords": [
		"exactjs",
		"compiler",
		"typescript",
		"tsx"
	]
}
