{
	"name": "@exactjs/compiler",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"dist/adapter-support.*",
		"dist/artifact-isolation.*",
		"dist/artifacts.*",
		"dist/cli.*",
		"dist/compilation",
		"!dist/compilation/analysis-results.*",
		"!dist/compilation/generated-diagnostics.*",
		"dist/contracts",
		"!dist/contracts/emission.*",
		"dist/explanation.*",
		"dist/exposures.*",
		"dist/expression/project.*",
		"dist/expression/session.*",
		"dist/expression/session-contracts.*",
		"dist/expression/watch-invalidation.*",
		"dist/ids.*",
		"dist/index.*",
		"dist/manifest",
		"dist/manifest-parse.*",
		"dist/names.*",
		"dist/native/executable.*",
		"dist/native/manifest.*",
		"dist/native/process.*",
		"dist/native/process-contracts.*",
		"dist/native/process-diagnostic-contracts.*",
		"dist/native/process-module-contracts.*",
		"dist/native/process-policy-contracts.*",
		"dist/native/process-semantic-contracts.*",
		"dist/native/process-worker.*",
		"dist/native/transformation.*",
		"dist/paths.*",
		"dist/plugins.*",
		"dist/policy-report.*",
		"dist/registry.*",
		"dist/source-maps.*",
		"dist/types.*",
		"dist/versions.*",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./adapter-support": {
			"types": "./dist/adapter-support.d.ts",
			"default": "./dist/adapter-support.js"
		}
	},
	"bin": {
		"exactc": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"@exactjs/plugin-host": "^0.1.0"
	},
	"optionalDependencies": {
		"@exactjs/compiler-native-darwin-arm64": "^0.1.0",
		"@exactjs/compiler-native-darwin-x64": "^0.1.0",
		"@exactjs/compiler-native-linux-arm64": "^0.1.0",
		"@exactjs/compiler-native-linux-x64": "^0.1.0",
		"@exactjs/compiler-native-win32-arm64": "^0.1.0",
		"@exactjs/compiler-native-win32-x64": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/core": "^0.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.1.5"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run --maxWorkers=4",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
