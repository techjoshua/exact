{
	"name": "@exactjs/compiler",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./adapter-support": {
			"types": "./dist/adapter-support.d.ts",
			"default": "./dist/adapter-support.js"
		}
	},
	"bin": {
		"exactc": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/expressions": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"@exactjs/plugin-host": "^0.1.0",
		"entities": "^6.0.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"devDependencies": {
		"vite": "^8.1.5"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
