{
	"name": "@exactjs/time",
	"version": "0.1.0",
	"description": "Clock-derived reactive view enhancements for eXact",
	"type": "module",
	"files": [
		"AGENTS.md",
		"README.md",
		"capability.d.ts",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./enhancements": {
			"types": "./capability.d.ts",
			"browser": "./dist/client/enhancements.js",
			"default": "./dist/server/enhancements.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"browser": "./dist/client/internal.js",
			"default": "./dist/server/internal.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"browser": "./dist/client/testing.js",
			"default": "./dist/server/testing.js"
		},
		"./language": {
			"types": "./dist/language.d.ts",
			"node": "./dist/server/language.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [
		"TimeUpdate",
		"TimeProvider"
	],
	"sideEffects": false,
	"exact": {
		"language": {
			"schemaVersion": 1,
			"analyzer": {
				"protocolVersion": "^1.0.0",
				"subpath": "./language",
				"capabilities": [
					"diagnostics",
					"completions",
					"hover",
					"inlayHints"
				],
				"projection": [
					"sourceText",
					"enhancements",
					"jsx",
					"expressions",
					"types"
				]
			}
		}
	},
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/language-extension-api": "^0.1.0",
		"@exactjs/reactive": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs . && node ../../scripts/generate-component-library-build-facts.mjs .",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
