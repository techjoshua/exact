{
  "name": "@exact/plugin-host",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "exact": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@exact/config": "file:../config",
    "@exact/plugin-api": "file:../plugin-api",
    "semver": "^7.8.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  }
}
