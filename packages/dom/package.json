{
	"name": "@exactjs/dom",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/reactive": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/jsx": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
