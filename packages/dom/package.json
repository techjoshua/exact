{
  "name": "@exact/dom",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@exact/core": "file:../core",
    "@exact/instrumentation": "file:../instrumentation",
    "@exact/reactive": "file:../reactive"
  },
  "devDependencies": {
    "@exact/jsx": "file:../jsx-runtime"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/run-package-coverage.mjs"
  }
}
