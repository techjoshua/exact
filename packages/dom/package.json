{
	"name": "@exactjs/dom",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		},
		"./enhanced": {
			"types": "./dist/enhanced.d.ts",
			"default": "./dist/enhanced.js"
		},
		"./framework/hydration": {
			"types": "./dist/framework/hydration.d.ts",
			"default": "./dist/framework/hydration.js"
		},
		"./framework/enhancements": {
			"types": "./dist/framework/enhancements.d.ts",
			"default": "./dist/framework/enhancements.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/devtools-protocol": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/reactive": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/accessibility": "^0.1.0",
		"@exactjs/jsx": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
