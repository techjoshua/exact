{
	"name": "@exactjs/intl-build",
	"version": "0.1.0",
	"description": "Shared bundler orchestration for eXact internationalization artifacts",
	"type": "module",
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/intl": "^0.1.0",
		"@exactjs/intl-analyzer": "^0.1.0",
		"saxes": "^6.0.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
