{
	"name": "@exactjs/intl-build",
	"version": "0.5.1",
	"description": "Shared bundler orchestration for eXact internationalization artifacts",
	"type": "module",
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.5.0",
		"@exactjs/intl": "^0.5.0",
		"@exactjs/intl-analyzer": "^0.5.0",
		"saxes": "^6.0.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "packages/intl-build"
	},
	"homepage": "https://techjoshua.github.io/exact/#/plugins/internationalization",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"keywords": [
		"exactjs",
		"i18n",
		"localization",
		"build-tools",
		"xliff"
	]
}
