			"types": "./dist/runtime/positional-projection.d.ts",
			"default": "./dist/runtime/positional-projection.js"
		},
		"./runtime/direct-logging-frame": {
			"types": "./dist/runtime/direct-logging-frame.d.ts",
			"default": "./dist/runtime/direct-logging-frame.js"
