{
	"name": "@exactjs/ssr",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"node": "./dist/plugins.js",
			"default": "./dist/plugins.js"
		},
		"./enhanced": {
			"types": "./dist/enhanced.d.ts",
			"default": "./dist/enhanced.js"
		},
		"./runtime/generic-components": {
			"types": "./dist/runtime/generic-components.d.ts",
			"default": "./dist/runtime/generic-components.js"
		},
		"./runtime/structural-boundaries": {
			"types": "./dist/runtime/structural-boundaries.d.ts",
			"default": "./dist/runtime/structural-boundaries.js"
		},
		"./runtime/resumption-boundaries": {
			"types": "./dist/runtime/resumption-boundaries.d.ts",
			"default": "./dist/runtime/resumption-boundaries.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"@exactjs/plugin-host": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"@exactjs/server": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/accessibility": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
