{
	"name": "@exactjs/tanstack-query",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/provider.d.ts",
			"default": "./dist/provider.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/react-compat-adapter-api": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"@tanstack/query-core": "^5.101.2"
	},
	"peerDependencies": {
		"@exactjs/react-compat": "^0.1.0",
		"@tanstack/react-query": ">=5 <6"
	},
	"peerDependenciesMeta": {
		"@exactjs/react-compat": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		}
	},
	"exact": {
		"reactCompatibility": {
			"schemaVersion": 1,
			"substitutions": {
				"@tanstack/react-query": {
					"variants": [
						{
							"version": ">=5 <6",
							"exports": {
								"QueryClientProvider": {
									"subpath": "./react",
									"export": "QueryClientProvider"
								}
							}
						}
					]
				}
			}
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
