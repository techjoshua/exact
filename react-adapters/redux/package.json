{
	"name": "@exact/redux",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exact/core": "file:../../packages/core",
		"@exact/react-compat-adapter-api": "file:../../packages/react-compat-adapter-api",
		"@exact/reactive": "file:../../packages/reactive"
	},
	"peerDependencies": {
		"@exact/react-compat": "0.0.0",
		"react-redux": ">=8 <10"
	},
	"peerDependenciesMeta": {
		"@exact/react-compat": {
			"optional": true
		},
		"react-redux": {
			"optional": true
		}
	},
	"exact": {
		"reactCompatibility": {
			"schemaVersion": 1,
			"substitutions": {
				"react-redux": {
					"variants": [
						{
							"version": ">=8 <10",
							"exports": {
								"Provider": {
									"subpath": "./react",
									"export": "Provider"
								},
								"useStore": {
									"subpath": "./react",
									"export": "useStore"
								},
								"useDispatch": {
									"subpath": "./react",
									"export": "useDispatch"
								},
								"useSelector": {
									"subpath": "./react",
									"export": "useSelector"
								}
							}
						}
					]
				}
			}
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	}
}
