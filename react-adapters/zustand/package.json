{
	"name": "@exactjs/zustand",
	"version": "0.6.0",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/core": "^0.6.0",
		"@exactjs/react-compat-adapter-api": "^0.5.0",
		"@exactjs/reactive": "^0.6.0"
	},
	"peerDependencies": {
		"@exactjs/react-compat": "^0.6.0",
		"zustand": ">=5 <6"
	},
	"peerDependenciesMeta": {
		"@exactjs/react-compat": {
			"optional": true
		}
	},
	"devDependencies": {
		"zustand": "^5.0.14"
	},
	"exact": {
		"reactCompatibility": {
			"schemaVersion": 1,
			"substitutions": {
				"zustand": {
					"variants": [
						{
							"version": ">=5 <6",
							"exports": {
								"createStore": {
									"subpath": ".",
									"export": "createStore"
								},
								"useStore": {
									"subpath": "./react",
									"export": "useStore"
								}
							}
						}
					]
				}
			}
		}
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "react-adapters/zustand"
	},
	"homepage": "https://techjoshua.github.io/exact/#/guides/react-compatibility",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "eXact integration and compatible store utilities for Zustand.",
	"keywords": [
		"exactjs",
		"zustand",
		"state-management",
		"stores"
	]
}
