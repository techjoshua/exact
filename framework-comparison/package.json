{
	"name": "@exactjs/framework-comparison-suite",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npm run build:exact && npm run build:react && npm run build:sveltekit && npm run build:nuxt",
		"build:exact": "vite build --config participants/exact/vite.config.ts && vite build --config participants/exact/vite.server.config.ts",
		"build:react": "vite build --config participants/react/vite.config.ts && vite build --config participants/react/vite.server.config.ts",
		"build:sveltekit": "cd participants/sveltekit && vite build",
		"build:nuxt": "nuxt build --cwd participants/nuxt",
		"build:exact-native": "cd participants/exact-native && npm run build",
		"build:react-native": "cd participants/react-native && npm run build",
		"check": "node src/check-suite.mjs",
		"dev:exact": "vite --config participants/exact/vite.config.ts --port 4401",
		"dev:react": "vite --config participants/react/vite.config.ts --port 4402",
		"dev:sveltekit": "cd participants/sveltekit && vite dev --port 4403",
		"dev:nuxt": "nuxt dev participants/nuxt --port 4404",
		"start:exact-native": "node participants/exact-native/dist/server/start.js",
		"start:react-native": "cd participants/react-native && npm run start",
		"measure": "npm run test:e2e && node src/measure.mjs --correctness-passed",
		"measure:development": "npm run test:e2e && node src/measure.mjs --correctness-passed --allow-unreviewed",
		"measure:startup-cpu": "npm run test:e2e && node src/measure-startup-cpu.mjs --correctness-passed",
		"measure:startup-cpu:development": "npm run test:e2e && node src/measure-startup-cpu.mjs --correctness-passed --allow-unreviewed",
		"measure:native": "npm run test:native && node src/measure-native.mjs --correctness-passed",
		"measure:native:development": "npm run test:native && node src/measure-native.mjs --correctness-passed --allow-unreviewed",
		"start:service": "node src/server.mjs",
		"test": "node --test test/*.test.mjs",
		"test:e2e": "npm run build && playwright test -c playwright.config.ts",
		"test:native": "npm run build:exact-native && npm run build:react-native && playwright test -c playwright.native.config.ts",
		"typecheck": "tsc -p participants/exact/tsconfig.json --noEmit && tsc -p participants/react/tsconfig.json --noEmit && svelte-check --tsconfig participants/sveltekit/tsconfig.json && nuxt typecheck --cwd participants/nuxt && tsc -p participants/exact-native/tsconfig.source.json --noEmit && cd participants/react-native && npm run typecheck"
	},
	"dependencies": {
		"@exactjs/compiler": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/hydrate": "^0.1.0",
		"@exactjs/jsx": "^0.1.0",
		"@exactjs/node-adapter": "^0.1.0",
		"@exactjs/server": "^0.1.0",
		"@exactjs/ssr": "^0.1.0",
		"@exactjs/vite-plugin": "^0.1.0",
		"@react-router/dev": "^7.18.2",
		"@react-router/node": "^7.18.2",
		"@react-router/serve": "^7.18.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"nuxt": "^4.5.2",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-router": "^7.18.2",
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vue-tsc": "^3.3.9"
	},
	"engines": {
		"node": ">=24"
	}
}
