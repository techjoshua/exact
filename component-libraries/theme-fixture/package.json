{
	"name": "@exactjs/theme-fixture",
	"version": "0.1.0",
	"private": true,
	"description": "Independent acceptance components for @exactjs/theme",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/theme": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/generate-component-library-build-facts.mjs .",
		"test": "vitest run"
	}
}
