{
	"name": "@exactjs/app-theme-preference",
	"version": "0.0.0",
	"private": true,
	"description": "Private shared appearance preference for eXact repository applications",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [
		"ThemeModeToggle",
		"ThemePreferenceProvider"
	],
	"sideEffects": [
		"./styles.css"
	],
	"exactComponentLibrary": {
		"protocol": 2,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/jsx": "^0.1.0",
		"@exactjs/ssr": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "vitest run"
	}
}
