{
	"name": "@exactjs/motion",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"capability.d.ts",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./capability.d.ts",
			"default": "./dist/index.js"
		},
		"./presets": {
			"types": "./dist/presets.d.ts",
			"default": "./dist/presets.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./capability.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/core": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
