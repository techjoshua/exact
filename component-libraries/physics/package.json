{
	"name": "@exactjs/physics",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"capability.d.ts",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./capability.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		},
		"./projections": {
			"types": "./dist/projections.d.ts",
			"browser": "./dist/client/projections.js",
			"default": "./dist/server/projections.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"browser": "./dist/client/testing.js",
			"default": "./dist/server/testing.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./capability.d.ts",
	"exactCompiledComponents": [
		"PhysicsElement",
		"PhysicsWorld"
	],
	"sideEffects": false,
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/reactive": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"scripts": {
		"build": "tsc6 -b && node ../../scripts/compile-exact-package.mjs . && node ../../scripts/generate-component-library-build-facts.mjs .",
		"test": "vitest run --config vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
