{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "@exact/jsx"
	},
	"references": [{ "path": "../../packages/core" }, { "path": "../../packages/jsx-runtime" }],
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
