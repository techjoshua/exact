{
	"name": "@exactjs/forms",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [
		"Checkbox",
		"Field",
		"FieldError",
		"FieldHelp",
		"Form",
		"Input",
		"Label",
		"Select",
		"Submit",
		"Textarea"
	],
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/ssr": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/jsx": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/testing": "^0.1.0",
		"@exactjs/vitest": "^0.1.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs . && node ../../scripts/generate-component-library-build-facts.mjs .",
		"test": "vitest run --config vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
