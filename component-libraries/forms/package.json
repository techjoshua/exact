{
	"name": "@exactjs/forms",
	"version": "0.5.1",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.fixtures.*",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client/index.js",
			"default": "./dist/server/index.js"
		}
	},
	"main": "./dist/server/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [
		"Checkbox",
		"Field",
		"FieldError",
		"FieldHelp",
		"Form",
		"Input",
		"Label",
		"Select",
		"Submit",
		"Textarea"
	],
	"exactComponentLibrary": {
		"protocol": 1,
		"build": "./dist/exact-component-build.json"
	},
	"dependencies": {
		"@exactjs/component-library": "^0.5.0",
		"@exactjs/core": "^0.5.0",
		"@exactjs/dom": "^0.5.0",
		"@exactjs/ssr": "^0.5.0"
	},
	"devDependencies": {
		"@exactjs/jsx": "^0.5.0",
		"@exactjs/testing": "^0.5.0",
		"@exactjs/vitest": "^0.5.0"
	},
	"scripts": {
		"build": "tsc -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "vitest run --config vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "Joshua Friesen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/techjoshua/exact.git",
		"directory": "component-libraries/forms"
	},
	"homepage": "https://techjoshua.github.io/exact/#/guides/forms",
	"bugs": {
		"url": "https://github.com/techjoshua/exact/issues"
	},
	"description": "Accessible form components for eXact applications.",
	"keywords": [
		"exactjs",
		"forms",
		"validation",
		"accessibility"
	]
}
