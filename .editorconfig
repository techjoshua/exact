root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,html}]
indent_style = tab
indent_size = 2

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[package-lock.json]
indent_style = space
indent_size = 2
