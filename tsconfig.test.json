{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest"],
    "jsx": "react-jsx",
    "jsxImportSource": "@exact/jsx"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "adapters/*/src/**/*.ts",
    "adapters/*/src/**/*.tsx",
    "apps/server-components/src/**/*.ts",
    "apps/server-components/src/**/*.tsx"
  ],
  "exclude": [
    "packages/*/dist",
    "adapters/*/dist",
    "apps/*/dist"
  ]
}
