  "diagnosticSources": {
    "prepare-single-payload": "import {readFile,writeFile} from 'node:fs/promises';\nimport assert from 'node:assert/strict';\nconst root='.tmp/node-output-plan/';\nlet source=await readFile(root+'hydration-native-count.mjs','utf8');\nfunction replace(a,b){assert.equal(source.split(a).length,2,a);source=source.replace(a,b);}\nreplace('function renderHydrationScriptWithByteCount(options, resumptionLayouts, capturedResumptions, target) {\\n\\treturn renderHydrationScriptValue(options, resumptionLayouts, capturedResumptions, target);','function renderHydrationScriptWithByteCount(options, resumptionLayouts, capturedResumptions, target, write) {\\n\\treturn renderHydrationScriptValue(options, resumptionLayouts, capturedResumptions, target, write);');\nreplace('function renderHydrationScriptValue(options, resumptionLayouts, capturedResumptions, byteTarget) {','function renderHydrationScriptValue(options, resumptionLayouts, capturedResumptions, byteTarget, write) {');\nreplace('return `${prefix}${payload}${suffix}`;','if(write){write(prefix);write(payload);write(suffix);return \"\";}\\n\\treturn `${prefix}${payload}${suffix}`;');\nreplace('}, void 0, captured, output));','}, void 0, captured, output, write));');\nawait writeFile(root+'single-payload.mjs',source);\n// Instrument only the verification artifact. Timed workers have no trace hooks.\nsource=source.replace('const payload = serializeValidatedHydrationPayload(compacted, reactiveCollections);','globalThis.__singlePayloadTrace.push(\"serialize\");\\n\\tconst payload = serializeValidatedHydrationPayload(compacted, reactiveCollections);');\nawait writeFile(root+'single-payload-traced.mjs',source);\nlet run=await readFile(root+'immediate-run.mjs','utf8');\nrun=run.replace(/const variants=\\[[\\s\\S]*?\\];/,`const variants=[\n {id:'baseline',entry:'baseline',adapter:'node-adapter-before'},\n {id:'whole-script',entry:'hydration-native-count',adapter:'immediate-adapter'},\n {id:'single-json-write',entry:'single-payload',adapter:'immediate-adapter'}\n];`);\nrun=run.replaceAll('immediate-run.mjs','single-payload-run.mjs').replaceAll('immediate-http.json','single-payload-http.json');\nrun=run.replace(\"'hydration-registered','hydration-records',\",\"'single-payload',\");\nawait writeFile(root+'single-payload-run.mjs',run);\nlet correctness=await readFile(root+'immediate-correctness.mjs','utf8');\ncorrectness=correctness.replace(\"from './hydration-registered.mjs'\",\"from './single-payload.mjs'\").replaceAll('immediate-correctness.json','single-payload-correctness.json');\nawait writeFile(root+'single-payload-correctness.mjs',correctness);\n",
    "single-payload-ordering": "import assert from 'node:assert/strict';\nimport {readFile,writeFile} from 'node:fs/promises';\nimport {renderParticipantToSink} from './single-payload-traced.mjs';\nconst trace=globalThis.__singlePayloadTrace=[];\nconst data=JSON.parse(await readFile('.tmp/positional-leaves/data.json','utf8'));\nconst chunks=[];\nrenderParticipantToSink(data,'/incidents/inc-101',chunk=>{chunks.push(chunk);trace.push(chunk.startsWith('<script type=')?'script-open':chunk==='</script>'?'script-close':chunk.startsWith('[1,')?'json-write':'html-write');},Buffer.byteLength);\nassert.equal(trace.filter(x=>x==='serialize').length,1);\nassert.equal(trace.filter(x=>x==='json-write').length,1);\nassert.ok(trace.indexOf('serialize')>trace.indexOf('html-write'));\nassert.equal(trace.indexOf('json-write'),trace.indexOf('script-open')+1);\nassert.equal(trace.indexOf('script-close'),trace.indexOf('json-write')+1);\nconst payload=JSON.parse(chunks[trace.indexOf('json-write')-1]);\nassert.equal(payload[0],1);\nassert.ok(payload[1]&64,'resumption records present in the single payload');\nawait writeFile('.tmp/node-output-plan/single-payload-ordering.json',JSON.stringify({trace,payload},null,2));\nconsole.log('Verified: one complete hydration serialization and one JSON write after HTML.');\n",
    "single-payload-correctness": "import assert from 'node:assert/strict';\nimport {createServer} from 'node:http';\nimport {once} from 'node:events';\nimport {readFile,writeFile} from 'node:fs/promises';\nimport {createHash} from 'node:crypto';\nimport {createExactProducedResponse} from '@exactjs/server';\nimport {writeNodeResponse} from './immediate-adapter.mjs';\nimport {renderParticipantToSink as baseline} from './baseline.mjs';\nimport {renderParticipantToSink as callbacks} from './single-payload.mjs';\nimport {renderParticipantToSink as records} from './hydration-records.mjs';\nconst initial=JSON.parse(await readFile('.tmp/positional-leaves/data.json','utf8'));\nconst results=[];\nfor(const [name,candidate] of Object.entries({callbacks,records}))for(const text of ['plain ASCII','</script><script>alert(1)</script>\\u2028\\u2029 🚀 \\ud800 & \"']){\n const data=structuredClone(initial);\n data.incidents[0].title=text;\n let expected='';const bytes=baseline(data,'/incidents/inc-101',s=>expected+=s,Buffer.byteLength);\n const chunks=[];const actualBytes=candidate(data,'/incidents/inc-101',s=>chunks.push(s),Buffer.byteLength);\n assert.equal(chunks.join(''),expected);assert.equal(actualBytes,bytes);assert.equal(Buffer.byteLength(expected),bytes);\n const server=createServer((request,response)=>{\n  const result=createExactProducedResponse(200,{'content-type':'text/html; charset=utf-8'},(write,environment)=>{\n   candidate(data,'/incidents/inc-101',write,environment?.encodedByteLength);\n  });\n  void writeNodeResponse(response,result).catch(error=>response.destroy(error));\n });\n try{\n  server.listen(0,'127.0.0.1');await once(server,'listening');\n  const response=await fetch('http://127.0.0.1:'+server.address().port);\n  const received=Buffer.from(await response.arrayBuffer());\n  assert.equal(response.status,200);assert.deepEqual(received,Buffer.from(expected));\n  results.push({name,input:text,bytes,chunks:chunks.length,sha256:createHash('sha256').update(received).digest('hex')});\n }finally{server.closeAllConnections();await new Promise((resolve,reject)=>server.close(error=>error?reject(error):resolve()));}\n}\nawait writeFile('.tmp/node-output-plan/single-payload-correctness.json',JSON.stringify({results},null,2));\nconsole.log(results);\n\nconst seen=[];\nconst response={statusCode:0,setHeader(){},write(chunk){seen.push(chunk);return true;},end(){seen.push('ended');}};\nconst result=createExactProducedResponse(200,{},write=>{\n write('<main>');assert.deepEqual(seen,['<main>']);\n write('text');assert.deepEqual(seen,['<main>','text']);\n write('</main>');assert.deepEqual(seen,['<main>','text','</main>']);\n});\nawait writeNodeResponse(response,result);\nassert.deepEqual(seen,['<main>','text','</main>','ended']);\nconsole.log('Immediate forwarding verified inside the producer');\n",
    "immediate-adapter": "import {writeNodeResponse as joined} from './node-adapter-before.mjs';\nimport {exactResponseBodyOf} from '@exactjs/server';\n\n/** Diagnostic: forwards every produced span to Node immediately, without an application buffer. */\nexport function writeNodeResponse(response,result,signal){\n const body=exactResponseBodyOf(result);\n if(body?.kind!=='produced'||!body.writeSynchronously)return joined(response,result,signal);\n return stream(response,result,body,signal);\n}\nasync function stream(response,result,body,signal){\n response.statusCode=result.status;\n for(const[name,value]of Object.entries(result.headers))response.setHeader(name,value);\n try{\n  const completion=body.writeSynchronously(chunk=>{\n   signal?.throwIfAborted();\n   response.write(chunk);\n  },{encodedByteLength:Buffer.byteLength});\n  if(completion)await completion;\n  signal?.throwIfAborted();\n  response.end();\n }catch(error){\n  try{await body.cancel(error);}catch{}\n  if(response.headersSent)response.destroy(error);\n  else{response.statusCode=500;response.end('diagnostic failure');}\n }\n}\n"
  }
