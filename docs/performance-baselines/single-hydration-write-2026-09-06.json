  "runners": {
    "run": "import {readFile,writeFile} from 'node:fs/promises';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport {createHash} from 'node:crypto';\nimport {balancedRoundOrder} from '../../framework-comparison/src/balanced-round-order.mjs';\nimport {measureSsrRequest,runSustainedSsrWindow,resetSsrClientConnections} from '../../framework-comparison/src/ssr-benchmark-client.mjs';\nimport {startSsrWorker,stopSsrWorker,controlSsrWorker} from '../../framework-comparison/src/ssr-worker-controller.mjs';\nimport {settleSsrWorkerInventoryStartup} from '../../framework-comparison/src/ssr-worker-inventory.mjs';\nimport {availableSsrRuntimes,ssrEnvironmentMetadata} from '../../framework-comparison/src/ssr-run-environment.mjs';\nimport {aggregateSsrThroughput} from '../../framework-comparison/src/ssr-benchmark-statistics.mjs';\nimport {startComparisonServer} from '../../framework-comparison/src/server.mjs';\nconst root=path.resolve('.tmp/node-output-plan'),suite=path.resolve('framework-comparison');\nconst variants=[\n {id:'baseline',entry:'baseline',adapter:'node-adapter-before'},\n {id:'whole-script',entry:'hydration-native-count',adapter:'immediate-adapter'},\n {id:'single-json-write',entry:'single-payload',adapter:'immediate-adapter'}\n];\nconst runtime=availableSsrRuntimes('node')[0];\nconst report={createdAt:new Date().toISOString(),environment:ssrEnvironmentMetadata([runtime]),method:{populations:2,rounds:12,windowMs:500,concurrency:32,lanes:['normal','preloaded']},artifacts:{},epochs:[],runners:{run:await readFile(path.join(root,'single-payload-run.mjs'),'utf8'),adapter:await readFile(path.join(root,'immediate-adapter.mjs'),'utf8')}};\nfor(const name of ['baseline','hydration-native-count','single-payload','confirmation-worker','immediate-adapter','node-adapter-before']){const data=await readFile(path.join(root,name+'.mjs'));report.artifacts[name]={bytes:data.length,sha256:createHash('sha256').update(data).digest('hex')};}\nconst service=await startComparisonServer();\ntry{\n for(let epoch=0;epoch<2;epoch++){\n const entries=balancedRoundOrder(variants,epoch).map(v=>({...v}));\n const startup=await settleSsrWorkerInventoryStartup(entries,entry=>startSsrWorker({runtime,participantId:entry.id==='react'?'react':'exact',environment:{COMPARISON_NODE_ADAPTER_ENTRY:path.join(root,entry.adapter+'.mjs'),...(entry.entry?{COMPARISON_EXACT_SERVER_ENTRY:path.join(root,entry.entry+'.mjs')}:{})},transport:'node-http',workerPath:path.join(root,'confirmation-worker.mjs'),workingDirectory:suite,serviceUrl:service.url}));\n try{\n  if(startup.failure)throw startup.failure;\n  let identity;\n  for(const entry of entries){entry.identity=await measureSsrRequest(entry.worker.url);if(!entry.identity.meaningful)throw new Error(JSON.stringify({id:entry.id,identity:entry.identity,body:await(await fetch(entry.worker.url)).text(),stderr:entry.worker.stderr()}));if(entry.id!=='react'){identity??=entry.identity.hash;assert.equal(entry.identity.hash,identity,entry.id);}}\n  const samples={epoch,identities:Object.fromEntries(entries.map(e=>[e.id,e.identity])),windows:[]};\n  for(const lane of balancedRoundOrder(['normal','preloaded'],epoch)){\n   const url=entry=>entry.worker.url+(lane==='preloaded'?'?__benchmarkPreloaded=1':'');\n   for(const entry of entries){await runSustainedSsrWindow(url(entry),32,2000);await controlSsrWorker(entry.worker,'reset');}\n   for(let round=0;round<12;round++)for(const entry of balancedRoundOrder(entries,round,epoch)){\n    const sample=await runSustainedSsrWindow(url(entry),32,500);\n    for(const result of sample.samples){assert.ok(result.meaningful);assert.equal(result.hash,entry.identity.hash);assert.equal(result.bytes,entry.identity.bytes);}\n    samples.windows.push({id:entry.id,lane,round,requests:sample.samples.length,elapsedMs:sample.elapsedMs});\n   }\n   console.log('Population',epoch+1,lane,Object.fromEntries(variants.map(v=>[v.id,aggregateSsrThroughput(samples.windows.filter(s=>s.id===v.id&&s.lane===lane)).aggregateRequestsPerSecond])));\n  }\n  report.epochs.push(samples);await writeFile(path.join(root,'single-payload-http.json'),JSON.stringify(report,null,2));\n }finally{for(const worker of startup.workers)await stopSsrWorker(worker);resetSsrClientConnections();}\n }\n report.summary=Object.fromEntries(['normal','preloaded'].map(lane=>[lane,Object.fromEntries(variants.map(v=>[v.id,aggregateSsrThroughput(report.epochs.flatMap(e=>e.windows).filter(s=>s.id===v.id&&s.lane===lane))]))]));\n report.complete=true;await writeFile(path.join(root,'single-payload-http.json'),JSON.stringify(report,null,2));console.log('FINAL',JSON.stringify(report.summary));\n}finally{await service.close();}\n",
    "adapter": "import {writeNodeResponse as joined} from './node-adapter-before.mjs';\nimport {exactResponseBodyOf} from '@exactjs/server';\n\n/** Diagnostic: forwards every produced span to Node immediately, without an application buffer. */\nexport function writeNodeResponse(response,result,signal){\n const body=exactResponseBodyOf(result);\n if(body?.kind!=='produced'||!body.writeSynchronously)return joined(response,result,signal);\n return stream(response,result,body,signal);\n}\nasync function stream(response,result,body,signal){\n response.statusCode=result.status;\n for(const[name,value]of Object.entries(result.headers))response.setHeader(name,value);\n try{\n  const completion=body.writeSynchronously(chunk=>{\n   signal?.throwIfAborted();\n   response.write(chunk);\n  },{encodedByteLength:Buffer.byteLength});\n  if(completion)await completion;\n  signal?.throwIfAborted();\n  response.end();\n }catch(error){\n  try{await body.cancel(error);}catch{}\n  if(response.headersSent)response.destroy(error);\n  else{response.statusCode=500;response.end('diagnostic failure');}\n }\n}\n"
