{
	"name": "@exactjs/bun-plugin",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/compiler": "^0.1.0",
		"@exactjs/instrumentation": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"@exactjs/plugin-host": "^0.1.0",
		"@exactjs/react-compat": "^0.1.0",
		"@exactjs/react-dom-compat": "^0.1.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run",
		"test:bun": "bun test src/bun.integration.test.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
