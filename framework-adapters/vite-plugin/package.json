			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/component-library-policy": "^0.6.0",
