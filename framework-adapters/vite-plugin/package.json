		"@exactjs/devtools-runtime": "^0.6.0",
		"@exactjs/instrumentation": "^0.5.0 || ^0.6.0",
		"@exactjs/intl": "^0.6.0",
		"@exactjs/intl-analyzer": "^0.6.0",
		"@exactjs/intl-build": "^0.6.0",
		"@exactjs/language-extension-host": "^0.5.0 || ^0.6.0",
