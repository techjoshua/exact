{
	"name": "@exactjs/microfrontends",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client-artifact/index.js",
			"default": "./dist/server-artifact/index.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./plugin-config": {
			"types": "./dist/plugin-config.d.ts",
			"default": "./dist/plugin-config.js"
		},
		"./artifacts": {
			"types": "./dist/artifacts.d.ts",
			"default": "./dist/artifacts.js"
		},
		"./build": {
			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"browser": "./dist/client-artifact/client.js",
			"default": "./dist/server-artifact/client.js"
		},
		"./rollup": {
			"types": "./dist/rollup.d.ts",
			"default": "./dist/rollup.js"
		},
		"./webpack": {
			"types": "./dist/webpack.d.ts",
			"default": "./dist/webpack.js"
		},
		"./bun": {
			"types": "./dist/bun.d.ts",
			"default": "./dist/bun.js"
		},
		"./webpack-feasibility": {
			"types": "./dist/webpack-feasibility.d.ts",
			"default": "./dist/webpack-feasibility.js"
		},
		"./bun-feasibility": {
			"types": "./dist/bun-feasibility.d.ts",
			"default": "./dist/bun-feasibility.js"
		}
	},
	"main": "./dist/server-artifact/index.js",
	"types": "./dist/index.d.ts",
	"exactCompiledComponents": [
		"RemoteComponent"
	],
	"exactCompileModules": [
		"src/client.ts"
	],
	"exactTargetDirectories": {
		"client": "client-artifact",
		"server": "server-artifact"
	},
	"sideEffects": false,
	"dependencies": {
		"@exactjs/compiler": "^0.1.0",
		"@exactjs/config": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/dom": "^0.1.0",
		"@exactjs/hydrate": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"@exactjs/server": "^0.1.0",
		"@exactjs/ssr": "^0.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"devDependencies": {
		"@exactjs/ssr": "^0.1.0",
		"@exactjs/testing": "^0.1.0",
		"@types/node": "^22.10.2",
		"vite": "^8.1.5"
	},
	"exact": {
		"plugin": {
			"schemaVersion": 1,
			"protocolVersion": "1.0.0",
			"configKey": "microfrontends",
			"entries": {
				"config": "./plugin-config",
				"configTypes": "./config"
			}
		}
	},
	"scripts": {
		"build": "tsc6 -b && node ../../scripts/compile-exact-package.mjs .",
		"test": "vitest run --config vitest.config.ts",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
