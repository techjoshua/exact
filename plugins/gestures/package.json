{
	"name": "@exactjs/gestures",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./presets": {
			"types": "./dist/presets.d.ts",
			"default": "./dist/presets.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./plugin-config": {
			"types": "./dist/plugin-config.d.ts",
			"default": "./dist/plugin-config.js"
		},
		"./render": {
			"types": "./dist/render.d.ts",
			"default": "./dist/render.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"dependencies": {
		"@exactjs/core": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0"
	},
	"devDependencies": {
		"@exactjs/dom": "^0.1.0",
		"@exactjs/reactive": "^0.1.0",
		"@exactjs/testing": "^0.1.0"
	},
	"exact": {
		"plugin": {
			"schemaVersion": 1,
			"protocolVersion": "1.0.0",
			"configKey": "gestures",
			"entries": {
				"config": "./plugin-config",
				"configTypes": "./config",
				"render": "./render",
				"client": "./client",
				"testing": "./testing"
			}
		}
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
