{
  "name": "@exact/secrets",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./plugin-config": {
      "types": "./dist/plugin-config.d.ts",
      "default": "./dist/plugin-config.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@exact/config": "file:../../packages/config",
    "@exact/plugin-api": "file:../../packages/plugin-api",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@exact/compiler": "file:../../packages/compiler",
    "@exact/core": "file:../../packages/core",
    "@exact/ssr": "file:../../packages/ssr"
  },
  "exact": {
    "plugin": {
      "schemaVersion": 1,
      "protocolVersion": "1.0.0",
      "configKey": "secrets",
      "entries": {
        "config": "./plugin-config",
        "configTypes": "./config",
        "server": "./server"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  }
}
