{
	"name": "@exactjs/secrets",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"AGENTS.md",
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./plugin-config": {
			"types": "./dist/plugin-config.d.ts",
			"default": "./dist/plugin-config.js"
		},
		"./providers": {
			"types": "./dist/providers.d.ts",
			"default": "./dist/providers.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@exactjs/config": "^0.1.0",
		"@exactjs/plugin-api": "^0.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"devDependencies": {
		"@exactjs/compiler": "^0.1.0",
		"@exactjs/core": "^0.1.0",
		"@exactjs/ssr": "^0.1.0"
	},
	"exact": {
		"plugin": {
			"schemaVersion": 1,
			"protocolVersion": "1.0.0",
			"configKey": "secrets",
			"entries": {
				"config": "./plugin-config",
				"configTypes": "./config",
				"server": "./server"
			}
		}
	},
	"scripts": {
		"build": "tsc6 -b",
		"test": "vitest run",
		"test:coverage": "node ../../scripts/run-package-coverage.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
